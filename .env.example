NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Must match the frontend's VITE_API_BASE_URL suffix (its default is
# http://localhost:3000/api/v1, so the default here is /api/v1).
API_PREFIX=/api/v1

# Origin used to build absolute photo URLs (e.g. bike photos) so <img> tags
# resolve correctly even though the frontend runs on a different origin
# (Vite dev server on :5173) than this API (:3000). Set this to wherever this
# API is actually reachable, e.g. https://api.bikeguard.example.com in prod.
PUBLIC_ORIGIN=http://localhost:3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/bikeguard

# Generate real random values for these two before deploying anywhere shared.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=12h
HMAC_SECRET=dev-hmac-pepper-change-me

# Frontend origin(s) allowed to call this API. Comma-separate for multiple, or use "*" in development.
CORS_ORIGIN=http://localhost:5173

UPLOADS_DIR=uploads
PUBLIC_UPLOADS_PATH=/uploads

# Optional , only needed once real gate hardware / the Gate Bridge exists.
# MQTT_URL=mqtts://broker.example.com:8883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_TOPIC_PREFIX=bikeguard/gates
