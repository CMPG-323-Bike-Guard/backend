{
  "name": "bikeguard-backend",
  "version": "0.1.0",
  "description": "BikeGuard REST API, verification engine and real-time gateway (CMPG-323-Bike-Guard/backend)",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
    "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx scripts/migrate.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:reset": "tsx scripts/seed.ts --reset",
    "typecheck": "tsc --noEmit",
    "gate-key": "tsx scripts/gate-key.ts",
    "fake-reader": "tsx scripts/fake-reader.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^8.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.10.1",
    "pg": "^8.13.1",
    "pino-pretty": "^11.3.0",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  }
}
